# SpendWise environment variables. Copy this file to `.env` and fill in
# every value before running the app — see CONVENTIONS.md #7 for the
# reasoning behind the two Supabase key pairs and the two database URLs.

# --- Supabase -----------------------------------------------------------
# Project settings → API. Use the publishable/secret key pair, NOT the
# legacy anon/service_role JWT-shaped keys (Supabase is deprecating those
# by end of 2026).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — never expose with a NEXT_PUBLIC_ prefix. Only needed for
# admin-level operations outside a user's own session; the app doesn't
# currently use it, but it's here for when that changes.
SUPABASE_SECRET_KEY=

# --- Database -------------------------------------------------------------
# Project settings → Connect → ORMs → Prisma. Both come pre-filled except
# the password.
# DATABASE_URL: pooled, transaction-mode (port 6543, ?pgbouncer=true) — what
# the app uses at runtime.
DATABASE_URL=
# DIRECT_URL: direct, session-mode (port 5432) — what `prisma migrate`
# needs.
DIRECT_URL=

# --- Setu Account Aggregator (sandbox) -------------------------------------
# https://bridge.setu.co → Account Aggregator → set up an FIU (company PAN +
# GSTIN, any values work in sandbox) → create an "Account Aggregator - Data"
# product → finish Step 1 to activate sandbox credentials, then read all
# three of these off "Step 2 — Test your product".
# See README's "Connecting the Setu AA sandbox" for the full walkthrough.
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
# The AA gateway host. Sandbox by default — switching a deploy to production
# is this variable, not a code change. Take the production host from your
# Bridge project rather than assuming it.
SETU_AA_BASE_URL=https://fiu-sandbox.setu.co
# The Account Aggregator handle a mobile number is turned into a VUA with
# (9999999999 -> 9999999999@onemoney). Must match the AA your product
# instance is wired to on the Bridge.
SETU_AA_HANDLE=onemoney
# Optional. If you configure a shared secret on the Bridge notification
# endpoint, put it here and /api/aa/webhook will require a matching
# HMAC-SHA256 of the raw body in the x-setu-signature header. Leaving it
# empty does NOT make the webhook trust its caller — that route re-reads
# every claim from Setu's API before acting on it either way.
SETU_WEBHOOK_SECRET=

# --- Claude API -------------------------------------------------------------
# https://console.anthropic.com/settings/keys — used for transaction
# categorization (ambiguous cases only; rules run first) and bill-scanner
# receipt extraction.
ANTHROPIC_API_KEY=

# --- PostHog -----------------------------------------------------------
# Project Settings → Project API Key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
