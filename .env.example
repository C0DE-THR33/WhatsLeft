# SpendWise environment variables. Copy this file to `.env` and fill in
# every value before running the app — see CONVENTIONS.md #7 for the
# reasoning behind the two Supabase key pairs and the two database URLs.

# --- Supabase -----------------------------------------------------------
# Project settings → API. Use the publishable/secret key pair, NOT the
# legacy anon/service_role JWT-shaped keys (Supabase is deprecating those
# by end of 2026).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — never expose with a NEXT_PUBLIC_ prefix. Only needed for
# admin-level operations outside a user's own session; the app doesn't
# currently use it, but it's here for when that changes.
SUPABASE_SECRET_KEY=

# --- Database -------------------------------------------------------------
# Project settings → Connect → ORMs → Prisma. Both come pre-filled except
# the password.
# DATABASE_URL: pooled, transaction-mode (port 6543, ?pgbouncer=true) — what
# the app uses at runtime.
DATABASE_URL=
# DIRECT_URL: direct, session-mode (port 5432) — what `prisma migrate`
# needs.
DIRECT_URL=

# --- Setu Account Aggregator (sandbox) -------------------------------------
# https://bridge.setu.co — create a sandbox project under Data > Account
# Aggregator to get these.
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=

# --- Claude API -------------------------------------------------------------
# https://console.anthropic.com/settings/keys — used for transaction
# categorization (ambiguous cases only; rules run first) and bill-scanner
# receipt extraction.
ANTHROPIC_API_KEY=

# --- PostHog -----------------------------------------------------------
# Project Settings → Project API Key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
