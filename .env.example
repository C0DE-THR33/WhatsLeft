# Supabase Postgres connection string used by Prisma.
# Get this from Supabase project settings -> Database -> Connection string (URI).
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth — Project settings -> API Keys.
# Supabase is deprecating the old anon/service_role (JWT) keys by end of
# 2026 in favor of these publishable (sb_publishable_...) / secret
# (sb_secret_...) keys — use the new ones, not the legacy JWT-shaped keys.
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Not used by any code yet (no admin/bypass-RLS operations exist) — only
# add if something genuinely needs to bypass Row Level Security server-side.
SUPABASE_SECRET_KEY=""

# Setu Account Aggregator sandbox — bridge.setu.co/v2, Data -> your FIU app.
# See src/lib/setu.ts for what these are used for.
SETU_BASE_URL="https://fiu-sandbox.setu.co"
SETU_CLIENT_ID=""
SETU_CLIENT_SECRET=""
SETU_PRODUCT_INSTANCE_ID=""

# Claude API — used for categorizing ambiguous transaction narrations and,
# later, structuring Bill Scanner OCR output.
ANTHROPIC_API_KEY=""

# PostHog — product analytics (activation, weekly engagement, retention).
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
